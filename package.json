{
  "name": "working-mom-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/lib",
    "db:setup": "tsx src/db/setup.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/setup.ts --reset && tsx src/db/seed.ts",
    "test:flows": "npm run db:reset:test && DATABASE_URL=file:./data/test.db vitest run src/server --no-file-parallelism",
    "db:reset:test": "DATABASE_URL=file:./data/test.db NODE_ENV=development tsx src/db/setup.ts --reset && DATABASE_URL=file:./data/test.db NODE_ENV=development tsx src/db/seed.ts",
    "local": "tsx scripts/local.ts",
    "totp": "tsx scripts/totp.ts",
    "smoke": "tsx scripts/smoke.ts",
    "render:start": "mkdir -p data && ([ -f data/wm.db ] || (NODE_ENV=development tsx src/db/setup.ts && NODE_ENV=development tsx src/db/seed.ts)) && next start -p ${PORT:-3000}"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "luxon": "^3.7.2",
    "next": "^15.5.29",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}